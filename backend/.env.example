# =====================================================================================
# Orçamento 2027 (OBZ) — Grupo ARA — Caminho B — variáveis de ambiente do backend
# Copie para .env e preencha. NÃO commitar .env com valores reais.
# =====================================================================================

# --- Banco de dados ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/obz2027

# --- Sessão da aplicação (cookie httpOnly assinado após login via SSO) ---
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-bytes
SESSION_TTL_MINUTES=30

# --- SSO Microsoft Entra ID (OAuth2/OIDC) ---
# PENDENTE: ainda não existe App Registration no Entra ID do Grupo ARA para este
# projeto (decisão registrada em 2026-08-08). Preencher os três valores abaixo
# assim que o TI registrar o app. Até lá, AZURE_TENANT_ID/AZURE_CLIENT_ID vazios
# fazem o servidor subir em modo "SSO não configurado" (ver src/auth/oidc.js) —
# as rotas /auth/* respondem 503 em vez de quebrar o boot da aplicação.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- E-mail (notificação ao FP&A quando um gestor envia uma versão) ---
# PENDENTE: sem SMTP_HOST/SMTP_USER/SMTP_PASS, o servidor sobe normal, só
# que src/email/notificacoes.js loga um aviso e não manda nada (ver
# emailConfigurado em src/config.js) — não bloqueia o envio do orçamento.
# Exemplo Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587,
# SMTP_USER/SMTP_PASS = uma conta de serviço (ou app password) do Grupo ARA.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Servidor ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Login de desenvolvimento (SEM senha) ---
# Só para testar a interface multiusuário enquanto o SSO do Entra ID não
# existe (ver src/auth/routes.js). Autentica como qualquer usuário cadastrado
# só com o e-mail — NUNCA true fora de uso local, mesmo com NODE_ENV=production
# como segunda trava (as duas precisam estar erradas ao mesmo tempo).
DEV_LOGIN_ENABLED=false
